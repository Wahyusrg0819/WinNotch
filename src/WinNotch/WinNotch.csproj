<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/WinNotch.ico</ApplicationIcon>
    <AssemblyName>WinNotch</AssemblyName>
    <Version>0.2.2</Version>
    <Description>A quiet place for what's playing.</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/WinNotch.ico"/></ItemGroup>
  <ItemGroup><PackageReference Include="System.Management" Version="10.0.0"/></ItemGroup>
</Project>
