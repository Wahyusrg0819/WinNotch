<UserControl x:Class="WinNotch.ExpandedControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Grid x:Key="MediaPanel" x:Name="MediaPanel" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="40"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Grid Margin="0,8,0,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="60" Height="60" CornerRadius="12" Background="{DynamicResource ArtworkSurfaceBrush}" VerticalAlignment="Center">
        <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ExpandedArt" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,60,60" RadiusX="12" RadiusY="12"/></Image.Clip></Image></Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="TrackTitle" Text="A little space for your music." FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="TrackArtist" Text="Play something in your favorite app." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe Fluent Icons" Padding="15,8" Background="Transparent" Click="OnPrevious" AutomationProperties.Name="Previous track" ToolTip="Previous track"/>
        <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe Fluent Icons" Width="46" Padding="10,8" Margin="8,0" Foreground="#101810" Background="{DynamicResource AccentBrush}" Click="OnPlay" AutomationProperties.Name="Play or pause" ToolTip="Play / pause"/>
        <Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe Fluent Icons" Padding="15,8" Background="Transparent" Click="OnNext" AutomationProperties.Name="Next track" ToolTip="Next track"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,4,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
      <ProgressBar x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" Height="3" Foreground="{DynamicResource AccentBrush}" Background="#2A2E2A" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Playback progress"/>
      <TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    </Grid>
    <Grid x:Key="TimerPanel" x:Name="TimerPanel" Grid.Row="1" Visibility="Collapsed">
      <StackPanel x:Name="TimerSetup" VerticalAlignment="Center">
        <TextBlock Text="Make a little time." FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="FocusPreset" Content="Focus 25m" Tag="Focus" Click="OnTimerPreset" Padding="10,6" FontSize="11" Background="{DynamicResource AccentSurfaceBrush}"/>
          <Button x:Name="BreakPreset" Content="Break 5m" Tag="ShortBreak" Click="OnTimerPreset" Padding="10,6" FontSize="11" Margin="5,0"/>
          <Button Content="Rest 15m" Tag="LongBreak" Click="OnTimerPreset" Padding="10,6" FontSize="11"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBox x:Name="TimerMinutes" Text="10" Width="48" MaxLength="3" Padding="5,3" FontSize="13" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" VerticalContentAlignment="Center" AutomationProperties.Name="Timer duration in minutes, 1 to 180"/>
          <TextBlock Text="min" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
          <Button x:Name="StartTimerButton" Content="Start timer" Click="OnStartTimer" Padding="12,5" FontSize="11"/>
        </StackPanel>
        <TextBlock x:Name="TimerHint" Text="Choose a preset or enter 1–180 minutes." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel x:Name="TimerActive" Visibility="Collapsed" VerticalAlignment="Center">
        <TextBlock x:Name="TimerPhase" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TimerCountdown" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
        <TextBlock x:Name="TimerStatusText" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="PauseTimerButton" Content="Pause" Click="OnPauseTimer" Padding="14,6" FontSize="11"/>
          <Button x:Name="NextTimerButton" Click="OnNextTimer" Padding="14,6" FontSize="11" Background="{DynamicResource AccentSurfaceBrush}" Visibility="Collapsed"/>
          <Button x:Name="CancelTimerButton" Content="Cancel" Click="OnCancelTimer" Padding="14,6" FontSize="11" Margin="8,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Grid>
    <StackPanel x:Key="BrightnessPanel" x:Name="BrightnessPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
      <TextBlock Text="Internal display" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="BrightnessStatus" Text="Checking brightness support…" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="OnBrightnessChanged" AutomationProperties.Name="Internal display brightness"/>
        <TextBlock x:Name="BrightnessPercent" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="Controls the built-in screen, wherever the notch is placed." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
    <Grid x:Key="NotificationPanel" x:Name="NotificationPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,9,0,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="NotificationApp" FontSize="10" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,6">
        <StackPanel><TextBlock x:Name="NotificationTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="NotificationBody" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
      </ScrollViewer>
      <Button x:Name="DismissNotificationButton" Grid.Row="2" Content="Dismiss preview" Click="OnDismissNotification" HorizontalAlignment="Left" Padding="10,4" FontSize="10" ToolTip="Keeps the original notification in Windows"/>
    </Grid>
    <StackPanel x:Key="CalendarPanel" x:Name="CalendarPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
      <TextBlock Text="UP NEXT · LOCAL AGENDA" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
      <TextBlock x:Name="CalendarTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
      <TextBlock x:Name="CalendarWhen" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12"/>
      <Button x:Name="ManageAgendaButton" Content="Manage agenda" Click="OnManageAgenda" HorizontalAlignment="Left" FontSize="11" Padding="12,6"/>
    </StackPanel>
    <Grid x:Key="DownloadsPanel" x:Name="DownloadsPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="DownloadsStatus" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      <Grid Grid.Row="1" Margin="0,6,0,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="DownloadsList" AutomationProperties.Name="Temporary files and recent downloads">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,7"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="DownloadsEmpty" Text="No download activity yet." FontSize="13" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal">
        <Button x:Name="OpenDownloadsButton" Content="Open folder" FontSize="10" Padding="10,4" Click="OnOpenDownloads"/>
        <Button x:Name="RetryDownloadsButton" Content="Retry" FontSize="10" Padding="10,4" Click="OnRetryDownloads" Margin="6,0,0,0"/>
        <TextBlock Text="File size · no percentage" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
    <Grid x:Key="BluetoothPanel" x:Name="BluetoothPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="BluetoothStatus" FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,6">
        <StackPanel>
          <TextBlock x:Name="BluetoothEmpty" Text="No paired devices. Add one in Windows settings." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
          <ItemsControl x:Name="BluetoothList" AutomationProperties.Name="Paired Bluetooth devices">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,7"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2">
        <TextBlock x:Name="BluetoothActionStatus" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ToggleBluetoothButton" Content="Turn on" FontSize="10" Padding="10,4" Click="OnToggleBluetooth" AutomationProperties.Name="Turn Bluetooth on or off"/>
          <Button x:Name="RefreshBluetoothButton" Content="Refresh" FontSize="10" Padding="10,4" Margin="6,0,0,0" Click="OnRefreshBluetooth"/>
          <Button x:Name="BluetoothSettingsButton" Content="Windows settings" FontSize="10" Padding="10,4" Margin="6,0,0,0" Click="OnBluetoothSettings" AutomationProperties.Name="Open Windows Bluetooth settings"/>
        </StackPanel>
        <TextBlock Text="Turning off disconnects Bluetooth accessories." FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>
  </UserControl.Resources>
  <Grid x:Name="ControlsRoot" Margin="22,14" Cursor="Arrow">
    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel x:Name="ModuleTabs" Orientation="Horizontal" HorizontalAlignment="Left">
        <Button x:Name="MediaTab" Content="Media" FontSize="11" Padding="6,4" Click="OnMediaTab" AutomationProperties.Name="Media panel"/>
        <Button x:Name="TimerTab" Content="Timer" FontSize="11" Padding="6,4" Margin="5,0,0,0" Click="OnTimerTab" AutomationProperties.Name="Timer panel"/>
        <Button x:Name="DisplayTab" Content="Display" FontSize="11" Padding="6,4" Margin="5,0,0,0" Click="OnDisplayTab" AutomationProperties.Name="Brightness panel"/>
        <Button x:Name="NotificationTab" Content="Alerts" FontSize="11" Padding="6,4" Margin="5,0,0,0" Click="OnNotificationTab" AutomationProperties.Name="Notification preview panel"/>
        <Button x:Name="CalendarTab" Content="Agenda" FontSize="11" Padding="6,4" Margin="5,0,0,0" Click="OnCalendarTab" AutomationProperties.Name="Local calendar panel"/>
        <Button x:Name="DownloadsTab" Content="Files" FontSize="11" Padding="6,4" Margin="5,0,0,0" Click="OnDownloadsTab" AutomationProperties.Name="Downloads panel" ToolTip="Downloads"/>
        <Button x:Name="BluetoothTab" Content="&#xE702;" FontFamily="Segoe Fluent Icons" FontSize="12" Padding="6,4" Margin="5,0,0,0" Click="OnBluetoothTab" AutomationProperties.Name="Bluetooth panel" ToolTip="Bluetooth"/>
      </StackPanel>
      <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="12" Background="Transparent" Padding="8,0" HorizontalAlignment="Right" Click="OnSettings" AutomationProperties.Name="Open settings" ToolTip="Settings"/>
    </Grid>
    <Grid x:Name="VolumeControls" Grid.Row="2" Margin="0,5,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
      <Button x:Name="MuteButton" Content="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="14" Padding="5" Background="Transparent" Click="OnMute" AutomationProperties.Name="Mute audio" ToolTip="Mute"/>
      <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="6,0" ValueChanged="OnVolumeChanged" AutomationProperties.Name="System volume"/>
      <TextBlock x:Name="VolumePercent" Grid.Column="2" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>
