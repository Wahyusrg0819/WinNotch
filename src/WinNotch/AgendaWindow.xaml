<Window x:Class="WinNotch.AgendaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch · Agenda" Icon="Assets/WinNotch.ico" Style="{StaticResource {x:Type Window}}" Width="590" Height="650" MinWidth="510" MinHeight="600" Background="{DynamicResource CanvasBrush}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="13"/></Style>
  </Window.Resources>
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Your local agenda." FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="Saved on this device. No account needed." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18">
      <ListBox x:Name="EventsList" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Saved agenda events">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Text="{Binding When}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyMessage" Text="No events yet. Add your first one below." Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="EditorHeading" Text="New event" FontSize="16" FontWeight="SemiBold"/>
      <Label Target="{Binding ElementName=EventTitle}" Content="Title" Foreground="{DynamicResource MutedBrush}" Padding="0,10,0,5"/>
      <TextBox x:Name="EventTitle" MaxLength="120" AutomationProperties.Name="Event title"/>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
        <StackPanel><Label Target="{Binding ElementName=EventDate}" Content="Date" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,5"/><DatePicker x:Name="EventDate" Height="34" VerticalContentAlignment="Center" SelectedDateFormat="Short" AutomationProperties.Name="Event date"/></StackPanel>
        <StackPanel Grid.Column="2"><Label Target="{Binding ElementName=EventTime}" Content="Time (24-hour)" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,5"/><TextBox x:Name="EventTime" MaxLength="5" AutomationProperties.Name="Event time, HH:mm"/></StackPanel>
      </Grid>
      <CheckBox x:Name="ReminderCheck" Content="Remind me 5 minutes before"/>
      <TextBlock x:Name="AgendaHelp" Text="Reminders need WinNotch open and follow your visibility settings. Past events are kept without replaying reminders. Times use the local time zone." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="DeleteEventButton" Content="Delete" Click="OnDelete" IsEnabled="False"/>
        <Button x:Name="NewEventButton" Grid.Column="2" Content="New event" Click="OnNew" Margin="0,0,8,0"/>
        <Button x:Name="SaveEventButton" Grid.Column="3" Content="Add event" Click="OnSave" Foreground="#10200D" Background="{DynamicResource AccentBrush}"/>
      </Grid>
      <TextBlock x:Name="AgendaStatus" TextWrapping="Wrap" MinHeight="32" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
  </Grid>
</Window>
