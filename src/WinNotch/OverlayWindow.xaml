<Window x:Class="WinNotch.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch" Style="{StaticResource {x:Type Window}}" Width="500" Height="260" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual" PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated">
  <Grid Background="{x:Null}">
    <Border x:Name="Notch" Width="126" Height="30" Background="#050505" CornerRadius="0,0,15,15"
            HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True" MouseEnter="OnEnter" MouseLeave="OnLeave"
            MouseLeftButtonUp="OnNotchClick" Cursor="Hand" AutomationProperties.Name="WinNotch. Click to open media controls.">
      <Grid>
        <Grid x:Name="IdleContent">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="4" Height="4" Fill="#505654"/>
            <Border Width="22" Height="3" CornerRadius="2" Background="#202322" Margin="7,0,0,0"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="CompactContent" Visibility="Collapsed" Margin="14,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
          <Border CornerRadius="7" Background="#202520" Width="26" Height="26" ClipToBounds="True">
            <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="CompactArt" Stretch="UniformToFill"/></Grid>
          </Border>
          <TextBlock x:Name="CompactTitle" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="CompactPlay" Grid.Column="2" FontFamily="Segoe Fluent Icons" FontSize="12" Padding="4" Background="Transparent" Click="OnPlay" AutomationProperties.Name="Play or pause"/>
        </Grid>
        <Grid x:Name="PeekContent" Visibility="Collapsed" Margin="16,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="PeekIcon" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,8,0">
            <TextBlock x:Name="PeekTitle" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="PeekLevel" Height="3" Minimum="0" Maximum="100" Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}" Background="#303531" BorderThickness="0" Visibility="Collapsed"/>
          </StackPanel>
          <TextBlock x:Name="PeekDetail" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="ExpandedContent" Visibility="Collapsed" Margin="22,17,22,17" Cursor="Arrow">
          <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="40"/><RowDefinition Height="24"/></Grid.RowDefinitions>
          <DockPanel>
            <TextBlock Text="WINNOTCH" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="12" Background="Transparent" Padding="5,0" HorizontalAlignment="Right" Click="OnSettings" AutomationProperties.Name="Open settings" ToolTip="Settings"/>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,10,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="60" Height="60" CornerRadius="12" Background="#202520" VerticalAlignment="Center">
              <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ExpandedArt" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,60,60" RadiusX="12" RadiusY="12"/></Image.Clip></Image></Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TrackTitle" Text="A little space for your music." FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="TrackArtist" Text="Play something in your favorite app." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe Fluent Icons" Padding="15,8" Background="Transparent" Click="OnPrevious" AutomationProperties.Name="Previous track" ToolTip="Previous track"/>
              <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe Fluent Icons" Width="46" Padding="10,8" Margin="8,0" Foreground="#101810" Background="{DynamicResource AccentBrush}" Click="OnPlay" AutomationProperties.Name="Play or pause" ToolTip="Play / pause"/>
              <Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe Fluent Icons" Padding="15,8" Background="Transparent" Click="OnNext" AutomationProperties.Name="Next track" ToolTip="Next track"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <ProgressBar x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" Height="3" Foreground="{DynamicResource AccentBrush}" Background="#2A2E2A" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Playback progress"/>
            <TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
