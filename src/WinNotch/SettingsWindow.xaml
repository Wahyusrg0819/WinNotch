<Window x:Class="WinNotch.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch · Settings" Icon="Assets/WinNotch.ico" Style="{StaticResource {x:Type Window}}" Width="760" Height="690" MinWidth="650" MinHeight="520" Background="{DynamicResource CanvasBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#151719" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="24,30,20,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="54" Height="24" Background="#050505" CornerRadius="0,0,11,11" HorizontalAlignment="Left" Margin="0,0,0,18"><Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/></Border>
          <TextBlock Text="WinNotch" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="A quieter kind of utility." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,30"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Border Background="#252C24" CornerRadius="8" Padding="12,10"><TextBlock Text="&#xE713;   Preferences" FontFamily="Segoe UI Variable, Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="13"/></Border>
          <TextBlock Text="LOCAL BY DESIGN" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,28,0,8"/>
          <TextBlock Text="No account.&#x0a;No cloud.&#x0a;Just your desktop." FontSize="12" LineHeight="22" Foreground="{DynamicResource MutedBrush}" Margin="12,0"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="VERSION 0.2.9  /  PREVIEW" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,27,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="Make room for less." FontSize="27" FontWeight="SemiBold"/>
        <TextBlock Text="Small details. Right where you need them." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="PreferencesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel>
          <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="CONNECTED TO YOUR DESKTOP" FontSize="9" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
              <TextBlock x:Name="DeviceStatus" Margin="0,9,0,0" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock x:Name="MediaStatus" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="StartupCheck" Content="Start WinNotch when I sign in"/>
          <CheckBox x:Name="TopmostCheck" Content="Keep the notch on top"/>
          <TextBlock Text="During fullscreen" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,7"/>
          <ComboBox x:Name="FullscreenSelect" AutomationProperties.Name="Fullscreen behavior"><ComboBoxItem Content="Hide all activity"/><ComboBoxItem Content="Critical alerts only (low battery)"/><ComboBoxItem Content="Show as usual"/></ComboBox>
          <TextBlock Text="Presentations, a locked desktop, and excluded apps always hide the notch." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock Text="Display &amp; app exclusions" FontSize="16" FontWeight="SemiBold" Margin="0,23,0,12"/>
          <ComboBox x:Name="DisplaySelect" AutomationProperties.Name="Display for the notch"/>
          <Button Content="Refresh displays" Click="OnRefreshDisplays" HorizontalAlignment="Left" FontSize="11" Padding="10,5" Margin="0,8,0,0"/>
          <TextBlock Text="If a selected display is unavailable, the primary display is used. Follow mode stays in place while you use the notch or settings." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/>
          <TextBlock Text="Hide while these apps are active" FontSize="12" Margin="0,0,0,6"/>
          <TextBox x:Name="ExclusionsText" AcceptsReturn="True" Height="72" VerticalScrollBarVisibility="Auto" Padding="8" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" AutomationProperties.Name="Excluded executable names, one per line"/>
          <Button Content="Add application…" Click="OnAddApplication" HorizontalAlignment="Left" FontSize="11" Padding="10,5" Margin="0,8,0,0"/>
          <TextBlock Text="One executable per line, e.g. chrome.exe. Remove a line to allow it again, then Save changes. Applies to all apps with that executable name." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
          <TextBlock Text="Appearance &amp; behavior" FontSize="16" FontWeight="SemiBold" Margin="0,23,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Shape" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/><ComboBox x:Name="ShapeSelect" AutomationProperties.Name="Notch shape"><ComboBoxItem Content="Attached to bezel"/><ComboBoxItem Content="Floating"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/><ComboBox x:Name="SizeSelect" AutomationProperties.Name="Notch size"><ComboBoxItem Content="Small"/><ComboBoxItem Content="Default"/><ComboBoxItem Content="Large"/></ComboBox></StackPanel>
          </Grid>
          <TextBlock Text="Visibility" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,15,0,7"/>
          <ComboBox x:Name="VisibilitySelect" AutomationProperties.Name="Notch visibility"><ComboBoxItem Content="Always visible"/><ComboBoxItem Content="Only when active"/><ComboBoxItem Content="Smart hide"/></ComboBox>
          <TextBlock Text="Smart hide keeps an idle notch out of maximized title bars." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/>
          <CheckBox x:Name="AnimationCheck" Content="Animate transitions"/>
          <ComboBox x:Name="AnimationSpeedSelect" AutomationProperties.Name="Animation speed" Margin="0,0,0,8"><ComboBoxItem Content="Relaxed animations"/><ComboBoxItem Content="Default animations"/><ComboBoxItem Content="Quick animations"/></ComboBox>
          <TextBlock Text="Windows reduced-motion preferences are always respected." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="Accent theme" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,15,0,7"/>
          <ComboBox x:Name="ThemeSelect" AutomationProperties.Name="Accent theme"><ComboBoxItem Content="Leaf"/><ComboBoxItem Content="Ice"/><ComboBoxItem Content="Amber"/></ComboBox>
          <CheckBox x:Name="TrueBlackCheck" Content="True black notch (otherwise near black)"/>
          <TextBlock Text="Modules" FontSize="16" FontWeight="SemiBold" Margin="0,23,0,6"/>
          <CheckBox x:Name="MediaCheck" Content="Media player &amp; album artwork"/>
          <CheckBox x:Name="BatteryCheck" Content="Battery &amp; charging events"/>
          <CheckBox x:Name="VolumeCheck" Content="Volume slider, mute &amp; indicator"/>
          <CheckBox x:Name="TimerCheck" Content="Timer &amp; Pomodoro (turning off cancels the timer)"/>
          <CheckBox x:Name="BrightnessCheck" Content="Internal display brightness slider &amp; indicator"/>
          <CheckBox x:Name="ClockCheck" Content="Show local time when idle"/>
          <TextBlock Text="The clock follows your visibility setting. Media and timers take priority." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <CheckBox x:Name="CalendarCheck" Content="Local calendar &amp; reminders"/>
          <Button Content="Manage agenda" Click="OnAgenda" HorizontalAlignment="Left" FontSize="11" Padding="10,6" Margin="0,0,0,8"/>
          <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
          <CheckBox x:Name="DownloadsCheck" Content="Watch the downloads folder"/>
          <TextBox x:Name="DownloadsFolderText" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" AutomationProperties.Name="Downloads folder"/>
          <WrapPanel Margin="0,8,0,0"><Button Content="Choose folder…" Click="OnChooseDownloads" FontSize="11" Padding="10,6"/><Button Content="Use Windows default" Click="OnDefaultDownloads" FontSize="11" Padding="10,6" Margin="8,0,0,0"/></WrapPanel>
          <TextBlock Text="Tracks .crdownload and .part files directly in this folder. Temporary files may be paused or interrupted; size is not a progress percentage. A rename to a final filename is shown as ready. Files are never opened or changed automatically." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
          <TextBlock x:Name="DownloadsSettingsStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
          <TextBlock Text="Bluetooth" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
          <CheckBox x:Name="BluetoothCheck" Content="Bluetooth devices &amp; on/off control"/>
          <TextBlock Text="Shows paired devices while the Bluetooth panel is open. Battery levels depend on the device and Windows driver. Turning off this module leaves Bluetooth unchanged." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
          <Button Content="Windows Bluetooth settings" Click="OnBluetoothSettings" HorizontalAlignment="Left" FontSize="11" Padding="10,6"/>
          <TextBlock x:Name="BluetoothSettingsStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
          <TextBlock Text="Notification previews" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
          <CheckBox x:Name="NotificationsCheck" Content="Preview new Windows notifications"/>
          <TextBlock Text="Content is processed locally, kept only in memory, and never logged. Dismissing a preview keeps the original in Windows." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <WrapPanel>
            <Button x:Name="NotificationAccessButton" Content="Allow access…" Click="OnNotificationAccess" FontSize="11" Padding="10,6" Margin="0,0,8,0"/>
            <Button Content="Windows privacy settings" Click="OnNotificationPrivacy" FontSize="11" Padding="10,6"/>
          </WrapPanel>
          <TextBlock x:Name="NotificationStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,12">
            <TextBlock Text="Display placement scales with Windows.&#x0a;Timers run while WinNotch is open; exiting or restarting cancels them.&#x0a;Media metadata stays in memory and is never logged." FontSize="11" LineHeight="19" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveStatus" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
        <Button Grid.Column="1" Content="Open player" Click="OnPlayer" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content="Save changes" Foreground="#10200D" Background="{DynamicResource AccentBrush}" Click="OnSave"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
